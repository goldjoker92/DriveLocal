{
  "name": "drivelocal",
  "main": "./index.js",
  "version": "1.0.10",
  "dependencies": {
    "@expo/ui": "~56.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/storage": "^25.1.0",
    "expo": "~56.0.16",
    "expo-asset": "~56.0.20",
    "expo-audio": "~56.0.12",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.22",
    "expo-image-picker": "~56.0.21",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.15",
    "expo-location": "~56.0.21",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.22",
    "expo-web-browser": "~56.0.5",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:dev": "expo start --dev-client",
    "test": "jest --ci --runInBand",
    "release:check": "node scripts/release/release-check.js",
    "release:ensure-prod-email-auth": "node scripts/release/ensure-prod-email-auth.js",
    "release:ensure-prod-android-api-key": "node scripts/release/ensure-prod-android-api-key.js",
    "release:prod-auth-smoke": "node scripts/release/prod-auth-smoke.js",
    "dispatch:smoke:prod": "node scripts/release/dispatch-smoke.js --project drivelocal-prod",
    "dispatch:smoke:dev": "node scripts/release/dispatch-smoke.js --project drivelocal-dev",
    "release:closed-test-gate": "npm run release:check && npm run release:ensure-prod-email-auth && npm run release:ensure-prod-android-api-key && npm run release:prod-auth-smoke",
    "validate:service-area": "node functions/scripts/validate-config.js --project drivelocal-dev --expect-env development",
    "validate:env:dev": "node functions/scripts/validate-config.js --project drivelocal-dev --expect-env development",
    "validate:env:prod": "node functions/scripts/validate-config.js --project drivelocal-prod --expect-env production",
    "geodata:import:horizonte": "node scripts/geodata/import-horizonte-ibge.js",
    "seed:service-area:dev": "node functions/scripts/seed-service-area.js --project drivelocal-dev",
    "seed:service-area:prod": "node functions/scripts/seed-service-area.js --project drivelocal-prod",
    "deploy:firebase:dev": "firebase deploy --only functions,firestore:rules,firestore:indexes,storage --project drivelocal-dev",
    "deploy:firebase:prod": "node -e \"if(process.env.CONFIRM_PRODUCTION_DEPLOY!=='DRIVELOCAL_PRODUCTION'){console.error('prod deploy requires CONFIRM_PRODUCTION_DEPLOY=DRIVELOCAL_PRODUCTION');process.exit(1)}\" && firebase deploy --only functions,firestore:rules,firestore:indexes,storage --project drivelocal-prod",
    "verify:firebase:dev": "firebase functions:list --project drivelocal-dev",
    "verify:firebase:prod": "firebase functions:list --project drivelocal-prod"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/"
    ]
  },
  "private": true
}
