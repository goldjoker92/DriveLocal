# Environnement de build local
APP_ENV=development
APP_SCHEME=drivelocal

# Outil de simulation DEV. Toujours 0 pour preview et production.
ENABLE_DEV_RIDE_SIMULATOR=1

# Clé native Android Maps. Restreindre à Maps SDK for Android,
# package com.drivelocal.app et SHA-1 du certificat utilisé.
GOOGLE_MAPS_ANDROID_API_KEY=

# Fichier de l'application Firebase Android sélectionnée pour le build.
# Pour release:check, ce fichier doit cibler drivelocal-prod.
GOOGLE_SERVICES_JSON=./google-services.json

# Configuration de l'application Firebase Web utilisée par le SDK JavaScript
# (Auth, Firestore, Storage et Functions). Les six valeurs doivent provenir de
# la Web App du même projet que GOOGLE_SERVICES_JSON.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Pages publiques HTTPS utilisées dans l'application et dans Google Play.
PRIVACY_POLICY_URL=https://rize-website-steel.vercel.app/drivelocal/privacy
TERMS_OF_USE_URL=https://rize-website-steel.vercel.app/drivelocal/terms
ACCOUNT_DELETION_WEB_URL=https://rize-website-steel.vercel.app/drivelocal/account-deletion

# Confirmations manuelles du gate production.
# Mettre YES uniquement après vérification réelle.
RELEASE_CONFIRM_PROD_SECRETS=
RELEASE_CONFIRM_DEV_APK=

# Secrets backend attendus dans Firebase Secret Manager PROD.
# Ne jamais placer leurs valeurs dans ce fichier ou dans le bundle mobile :
# ROUTING_PROVIDER_API_KEY
# MERCADO_PAGO_ACCESS_TOKEN
# MERCADO_PAGO_WEBHOOK_SECRET
