rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isOwner(driverId) {
      return isSignedIn() && request.auth.uid == driverId;
    }

    function validDriverImageWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function validProfilePhotoWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg)');
    }

    function validCriminalCertificateWrite(fileName) {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size < 5 * 1024 * 1024 &&
        ((fileName == 'certificate.pdf' && request.resource.contentType == 'application/pdf') ||
         (fileName == 'certificate.jpg' &&
          request.resource.contentType == 'image/jpeg'));
    }

    // Once a version is registered in drivers/{uid}, its source files become
    // immutable. A malicious/old client cannot replace the bytes after the admin
    // has opened the candidate. A replacement always receives a new version path.
    function candidateVersionRegistered(driverId, version) {
      return firestore.exists(/databases/(default)/documents/drivers/$(driverId)) &&
        firestore.get(/databases/(default)/documents/drivers/$(driverId))
          .data.get('driverPhotoCandidateVersion', '') == version;
    }

    function criminalCertificateVersionRegistered(driverId, version) {
      return firestore.exists(/databases/(default)/documents/drivers/$(driverId)) &&
        firestore.get(/databases/(default)/documents/drivers/$(driverId))
          .data.get('criminalCertificateVersion', '') == version;
    }

    // Dedicated private profile-photo package. The backend later publishes it as
    // JPEG, so mismatched PNG/WebP bytes with a .jpg name are rejected here.
    match /drivers/{driverId}/profile-photo/{version}/{fileName} {
      allow write: if isOwner(driverId) &&
        fileName in ['original.jpg', 'public-candidate.jpg'] &&
        validProfilePhotoWrite() &&
        !candidateVersionRegistered(driverId, version);
      allow read: if isOwner(driverId) || isAdmin();
    }

    // Private, versioned criminal certificate. Registering its version in the
    // driver profile locks the bytes; every replacement uses a new random path.
    match /drivers/{driverId}/criminal-certificate/{version}/{fileName} {
      allow write: if isOwner(driverId) &&
        version.matches('[A-Za-z0-9_-]{8,80}') &&
        validCriminalCertificateWrite(fileName) &&
        !criminalCertificateVersionRegistered(driverId, version);
      allow read: if isOwner(driverId) || isAdmin();
    }

    // Legacy/root driver documents (CNH, CRLV, vehicle photo, etc.). This match is
    // intentionally one level deep so it cannot bypass the profile-photo lock.
    match /drivers/{driverId}/{fileName} {
      allow write: if isOwner(driverId) && validDriverImageWrite();
      allow read: if isOwner(driverId) || isAdmin();
    }

    // Versioned, admin-approved driver profile photos. Client writes are forbidden;
    // Cloud Functions Admin SDK publishes the sanitized immutable copy here.
    match /publicDriverPhotos/{driverId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Opaque, admin-approved passenger profile photos. The object name contains no
    // passenger uid. The path is disclosed to a driver only after ride acceptance.
    match /publicPassengerPhotos/{fileName} {
      allow read: if isSignedIn() && fileName.matches('[A-Za-z0-9_-]{12,80}\\.jpg');
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
