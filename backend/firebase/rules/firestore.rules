rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is a registered admin.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && request.auth.uid == driverId;
      allow update: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Iteration 3A — passengers own their profile; admins may read.
    match /passengers/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Iteration 3A — a passenger creates/reads their own ride requests; admins
    // read all. Driver accept/dispatch/assignment is a LATER iteration, so
    // update/delete stay closed and drivers have no access yet.
    match /rideRequests/{rideId} {
      allow create: if request.auth != null &&
        request.resource.data.passengerId == request.auth.uid;
      allow read:   if request.auth != null &&
        (resource.data.passengerId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
