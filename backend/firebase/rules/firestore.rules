rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is a registered admin.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // True when {uid} is a registered AND admin-APPROVED driver.
    // Source of truth: drivers/{uid}.verificationStatus == "approved"
    // (written by driverService.approveDriver; the app has no isApproved field).
    function isApprovedDriver(uid) {
      return exists(/databases/$(database)/documents/drivers/$(uid)) &&
        get(/databases/$(database)/documents/drivers/$(uid)).data.verificationStatus == 'approved';
    }

    // PricingV1: on a rideRequests update, the passenger-owned pricing snapshot
    // must NOT change. Protects commission integrity from a driver rewriting the
    // fare/distance. (Does NOT protect wallet/commission math — see note below.)
    function ridePricingFieldsUnchanged() {
      return request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.ridePriceCentavos == resource.data.ridePriceCentavos &&
        request.resource.data.driverAmountCentavos == resource.data.driverAmountCentavos &&
        request.resource.data.distanceKm == resource.data.distanceKm &&
        request.resource.data.vehicleType == resource.data.vehicleType;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && request.auth.uid == driverId;
      allow update: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Iteration 3A — passengers own their profile; admins may read.
    match /passengers/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // PricingV1 bridge — a passenger creates/reads their own ride requests;
    // admins read all; an APPROVED driver may read PENDING offers and rides
    // assigned to them, claim a pending ride for themselves, then update the
    // ride they own (accept -> complete -> commission settlement).
    match /rideRequests/{rideId} {
      allow create: if request.auth != null &&
        request.resource.data.passengerId == request.auth.uid;

      // Read: passenger owner, the assigned driver, an admin, or an APPROVED
      // driver but ONLY for still-pending offers (limits passenger data exposure).
      allow read: if request.auth != null &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         isAdmin() ||
         (isApprovedDriver(request.auth.uid) && resource.data.status == 'pending'));

      // Update: admins always; otherwise an APPROVED driver who leaves the
      // pricing snapshot unchanged AND either
      //   (a) CLAIMS a pending, unassigned ride, setting driverId to themselves, or
      //   (b) is the already-assigned driver (complete / settle commission).
      allow update: if isAdmin() ||
        (request.auth != null &&
         isApprovedDriver(request.auth.uid) &&
         ridePricingFieldsUnchanged() &&
          (
            (resource.data.driverId == null &&
             resource.data.status == 'pending' &&
             request.resource.data.driverId == request.auth.uid) ||
            resource.data.driverId == request.auth.uid
          ));

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
