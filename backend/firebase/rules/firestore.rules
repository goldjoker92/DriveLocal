rules_version = '2';

// DriveLocal Firestore security — server-authoritative ride, financial and
// driver-photo approval state.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function driverCreateSafe() {
      return [
        'uid', 'email', 'serviceAreaId', 'displayName',
        'fullName', 'whatsApp', 'cpf', 'pixKeyType', 'pixKey',
        'vehicleType', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
        'vehiclePlate', 'vehicleYear', 'profilePhotoUrl',
        'verificationStatus', 'profileStatus', 'vehicleStatus',
        'documentsStatus', 'selfieStatus', 'duplicateCheckStatus',
        'createdAt', 'updatedAt'
      ];
    }

    function driverInitialCreateValid(driverId) {
      return request.resource.data.uid == driverId &&
        request.resource.data.email is string &&
        request.resource.data.serviceAreaId == 'HORIZONTE_CE_BR' &&
        request.resource.data.verificationStatus == 'draft' &&
        request.resource.data.profileStatus == 'incomplete' &&
        request.resource.data.vehicleStatus == 'incomplete' &&
        request.resource.data.documentsStatus == 'missing' &&
        request.resource.data.selfieStatus == 'missing' &&
        request.resource.data.duplicateCheckStatus == 'clear' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function driverUpdateSafe() {
      return [
        'displayName', 'fullName', 'whatsApp', 'cpf', 'pixKeyType', 'pixKey',
        'vehicleType', 'vehicleBrand', 'vehicleModel', 'vehicleColor',
        'vehiclePlate', 'vehicleYear',
        // Legacy fields remain writable for existing documents. New driver profile
        // photos use the strict candidate transition below.
        'profilePhotoUrl', 'profileStatus', 'vehicleStatus',
        'selfieUrl', 'selfieStatus',
        'cnhFrenteUrl', 'cnhFrenteStatus', 'cnhVersoUrl', 'cnhVersoStatus',
        'crlvUrl', 'crlvStatus', 'vehiclePhotoUrl', 'vehiclePhotoStatus',
        'motofreteUrl', 'motofreteStatus',
        'availabilityStatus', 'availabilityUpdatedAt',
        'location', 'locationAccuracyMeters', 'locationHeadingDegrees',
        'locationSpeedMps', 'locationUpdatedAtMs', 'locationUpdatedAt',
        'updatedAt'
      ];
    }

    function driverPhotoCandidateFields() {
      return [
        'driverPhotoCandidateOriginalPath',
        'driverPhotoCandidatePublicPath',
        'driverPhotoCandidateVersion',
        'driverPhotoReviewStatus',
        'driverPhotoSubmittedAt',
        'driverPhotoRejectionCode',
        'driverPhotoRejectionReason',
        'selfieStatus',
        'updatedAt'
      ];
    }

    function driverPhotoCandidateUpdateValid(driverId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let version = request.resource.data.driverPhotoCandidateVersion;
      let base = 'drivers/' + driverId + '/profile-photo/' + version;
      return changed.hasOnly(driverPhotoCandidateFields()) &&
        version is string && version.size() >= 8 && version.size() <= 80 &&
        request.resource.data.driverPhotoCandidateOriginalPath == base + '/original.jpg' &&
        request.resource.data.driverPhotoCandidatePublicPath == base + '/public-candidate.jpg' &&
        request.resource.data.driverPhotoReviewStatus == 'pending' &&
        request.resource.data.selfieStatus == 'submitted' &&
        request.resource.data.driverPhotoSubmittedAt == request.time &&
        request.resource.data.driverPhotoRejectionCode == null &&
        request.resource.data.driverPhotoRejectionReason == null &&
        request.resource.data.updatedAt == request.time &&
        // Client submission can never publish or approve a photo.
        request.resource.data.driverPhotoPublicPath == resource.data.driverPhotoPublicPath &&
        request.resource.data.driverPhotoPublicVersion == resource.data.driverPhotoPublicVersion &&
        request.resource.data.driverPhotoApprovedAt == resource.data.driverPhotoApprovedAt &&
        request.resource.data.driverPhotoApprovedBy == resource.data.driverPhotoApprovedBy;
    }

    function newPhotoPackageSubmitted() {
      return request.resource.data.selfieStatus in ['submitted', 'approved'] &&
        request.resource.data.driverPhotoCandidateOriginalPath is string &&
        request.resource.data.driverPhotoCandidatePublicPath is string &&
        request.resource.data.driverPhotoCandidateVersion is string &&
        request.resource.data.driverPhotoReviewStatus in ['pending', 'approved'];
    }

    function legacySelfieSubmitted() {
      return request.resource.data.selfieStatus in ['submitted', 'approved'] &&
        request.resource.data.selfieUrl is string;
    }

    // A driver may submit the package while the profile photo is pending. The
    // secure approveDriver callable separately requires the public photo approval.
    function requiredDriverDocumentsSubmitted() {
      return request.resource.data.profileStatus == 'complete' &&
        request.resource.data.vehicleStatus == 'complete' &&
        (newPhotoPackageSubmitted() || legacySelfieSubmitted()) &&
        request.resource.data.cnhFrenteStatus == 'submitted' &&
        request.resource.data.cnhFrenteUrl is string &&
        request.resource.data.cnhVersoStatus == 'submitted' &&
        request.resource.data.cnhVersoUrl is string &&
        request.resource.data.crlvStatus == 'submitted' &&
        request.resource.data.crlvUrl is string &&
        request.resource.data.vehiclePhotoStatus == 'submitted' &&
        request.resource.data.vehiclePhotoUrl is string &&
        (request.resource.data.vehicleType != 'moto' || (
          request.resource.data.motofreteStatus == 'submitted' &&
          request.resource.data.motofreteUrl is string
        ));
    }

    function driverDocumentsSubmissionValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['documentsStatus', 'submittedAt', 'updatedAt']) &&
        resource.data.verificationStatus in ['draft', 'correction_requested'] &&
        request.resource.data.documentsStatus == 'submitted' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        requiredDriverDocumentsSubmitted();
    }

    function driverReviewTransitionValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'verificationStatus', 'duplicateCheckStatus', 'submittedAt', 'updatedAt'
        ]) &&
        resource.data.verificationStatus in ['draft', 'correction_requested'] &&
        request.resource.data.documentsStatus == 'submitted' &&
        request.resource.data.verificationStatus == 'pending_review' &&
        request.resource.data.duplicateCheckStatus == 'pending_admin_review' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        requiredDriverDocumentsSubmitted();
    }

    function driverAdminReviewSafe() {
      return [
        'documentsStatus', 'selfieStatus',
        'cnhFrenteStatus', 'cnhVersoStatus', 'crlvStatus',
        'vehiclePhotoStatus', 'motofreteStatus',
        'reviewNote', 'adminNote',
        'updatedAt'
      ];
    }

    function passengerCreateSafe() {
      return [
        'uid', 'email', 'fullName', 'whatsApp', 'role',
        'serviceAreaId', 'createdAt', 'updatedAt'
      ];
    }

    function passengerUpdateSafe() {
      return ['fullName', 'whatsApp', 'displayName', 'updatedAt'];
    }

    function pointValid(point) {
      return point.lat is number &&
        point.lng is number &&
        point.lat >= -90 && point.lat <= 90 &&
        point.lng >= -180 && point.lng <= 180;
    }

    function driverLocationFields() {
      return [
        'location', 'locationAccuracyMeters', 'locationHeadingDegrees',
        'locationSpeedMps', 'locationUpdatedAtMs', 'locationUpdatedAt'
      ];
    }

    function driverOperationalUpdateValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let locationChanged = changed.hasAny(driverLocationFields());
      let availabilityChanged = changed.hasAny(['availabilityStatus', 'availabilityUpdatedAt']);

      return (!locationChanged || (
          request.resource.data.keys().hasAll(driverLocationFields()) &&
          pointValid(request.resource.data.location) &&
          request.resource.data.locationUpdatedAtMs is int &&
          request.resource.data.locationUpdatedAt == request.time &&
          (request.resource.data.locationAccuracyMeters == null || request.resource.data.locationAccuracyMeters is number) &&
          (request.resource.data.locationHeadingDegrees == null || request.resource.data.locationHeadingDegrees is number) &&
          (request.resource.data.locationSpeedMps == null || request.resource.data.locationSpeedMps is number)
        )) &&
        (!availabilityChanged || (
          request.resource.data.availabilityStatus in ['online', 'offline'] &&
          request.resource.data.availabilityUpdatedAt == request.time
        )) &&
        request.resource.data.updatedAt == request.time;
    }

    function liveLocationKeys() {
      return [
        'rideId', 'driverId', 'vehicleType', 'location',
        'accuracyMeters', 'headingDegrees', 'speedMps',
        'updatedAtMs', 'updatedAt'
      ];
    }

    function livePointValid(data) {
      return pointValid(data.location);
    }

    function liveOptionalNumbersValid(data) {
      return (data.accuracyMeters == null || data.accuracyMeters is number) &&
        (data.headingDegrees == null || data.headingDegrees is number) &&
        (data.speedMps == null || data.speedMps is number);
    }

    function rideIsLocationActive(rideId) {
      let ride = get(/databases/$(database)/documents/rideRequests/$(rideId)).data;
      return ride.status in ['assigned', 'driver_arrived', 'in_progress'];
    }

    function isAcceptedRideDriver(rideId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/rideRequests/$(rideId)).data.acceptedDriverId == request.auth.uid;
    }

    function isRidePassenger(rideId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/rideRequests/$(rideId)).data.passengerId == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();

      allow create: if isOwner(driverId) &&
        request.resource.data.keys().hasOnly(driverCreateSafe()) &&
        driverInitialCreateValid(driverId);

      allow update: if
        (isAdmin() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(driverAdminReviewSafe())) ||
        (isOwner(driverId) && (
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(driverUpdateSafe()) &&
           driverOperationalUpdateValid()) ||
          driverPhotoCandidateUpdateValid(driverId) ||
          driverDocumentsSubmissionValid() ||
          driverReviewTransitionValid()
        ));

      allow delete: if false;
    }

    match /privateDriverData/{driverId} {
      allow read, write: if false;
    }

    match /passengers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(passengerCreateSafe());
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(passengerUpdateSafe());
      allow delete: if false;
    }

    match /rideRequests/{rideId} {
      allow create: if isSignedIn() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.driverId == null &&
        request.resource.data.acceptedDriverId == null &&
        request.resource.data.assignedDriverId == null &&
        request.resource.data.commissionSettled == false;
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if false;
    }

    match /driverOffers/{offerId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /activeRideLocations/{rideId} {
      allow read: if isAdmin() || isAcceptedRideDriver(rideId) || isRidePassenger(rideId);

      allow create, update: if isAcceptedRideDriver(rideId) &&
        rideIsLocationActive(rideId) &&
        request.resource.data.keys().hasAll(liveLocationKeys()) &&
        request.resource.data.keys().hasOnly(liveLocationKeys()) &&
        request.resource.data.rideId == rideId &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.vehicleType in ['moto', 'car'] &&
        request.resource.data.updatedAtMs is int &&
        request.resource.data.updatedAt == request.time &&
        livePointValid(request.resource.data) &&
        liveOptionalNumbersValid(request.resource.data);

      allow delete: if isAdmin() || isAcceptedRideDriver(rideId);
    }

    match /cityPublicConfig/{serviceAreaId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /cityPrivateConfig/{serviceAreaId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /idempotencyOperations/{docId}  { allow read, write: if false; }
    match /auditLogs/{docId}              { allow read, write: if false; }
    match /walletTransactions/{docId}     { allow read, write: if false; }
    match /paymentRequests/{docId}        { allow read, write: if false; }
    match /subscriptionPayments/{docId}   { allow read, write: if false; }
    match /notificationEvents/{docId}     { allow read, write: if false; }
    match /notificationTokens/{docId}     { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
