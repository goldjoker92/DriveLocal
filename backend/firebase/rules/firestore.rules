rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is a registered admin.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && request.auth.uid == driverId;
      allow update: if request.auth != null &&
        (request.auth.uid == driverId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Iteration 3A — passengers own their profile; admins may read.
    match /passengers/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Containment (pre-BLOCK 04/08). A passenger creates/reads ONLY their own
    // ride request; admins may read. Drivers have NO access here: no listing or
    // reading of pending rides, and no client-side claim/accept/assignment/
    // status/pricing/commission/wallet/settlement/completion writes. All ride
    // mutation, targeted driver offers, and transactional acceptance move to
    // secure Cloud Functions (BLOCK 08) under the final authorization model
    // (BLOCK 04). Client update and delete stay denied until then.
    match /rideRequests/{rideId} {
      allow create: if request.auth != null &&
        request.resource.data.passengerId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.passengerId == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
