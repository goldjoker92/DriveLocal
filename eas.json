{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "image": "sdk-56",
      "node": "22.22.2",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "APP_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "image": "sdk-56",
      "node": "22.22.2",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "APP_ENV": "dev"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "image": "sdk-56",
      "node": "22.22.2",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
