{
  "firestore": {
    "rules": "backend/firebase/rules/firestore.rules",
    "indexes": "backend/firebase/indexes/firestore.indexes.json"
  },
  "storage": {
    "rules": "backend/firebase/rules/storage.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "**/__tests__/**",
      "**/*.test.js",
      "jest.config.js"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
